#compdef xtgeoip

autoload -U is-at-least

_xtgeoip() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'(--no-log)--log-file=[Write the log to PATH, overriding \[logging\] in the config]:PATH:_default' \
'--config=[Read configuration from PATH instead of /etc/xtgeoip.conf]:PATH:_files' \
'--ca-file=[Verify the MaxMind server against the CA bundle in PATH]:PATH:_files' \
'-b[Back up current database before replacing it]' \
'--backup[Back up current database before replacing it]' \
'-c[Delete current binary database files]' \
'--clean[Delete current binary database files]' \
'-f[Force the operation (overrides safety checks)]' \
'--force[Force the operation (overrides safety checks)]' \
'-l[Enable legacy mode (historical compatibility only)]' \
'--legacy[Enable legacy mode (historical compatibility only)]' \
'-p[Prune old bin archives (requires --backup)]' \
'--prune[Prune old bin archives (requires --backup)]' \
'--no-log[Disable file logging, overriding \[logging\] in the config]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_xtgeoip_commands" \
"*::: :->xtgeoip" \
&& ret=0
    case $state in
    (xtgeoip)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:xtgeoip-command-$line[1]:"
        case $line[1] in
            (run)
_arguments "${_arguments_options[@]}" : \
'(--no-log)--log-file=[Write the log to PATH, overriding \[logging\] in the config]:PATH:_default' \
'--config=[Read configuration from PATH instead of /etc/xtgeoip.conf]:PATH:_files' \
'--ca-file=[Verify the MaxMind server against the CA bundle in PATH]:PATH:_files' \
'-b[Back up current database before replacing it]' \
'--backup[Back up current database before replacing it]' \
'-c[Delete current binary database files]' \
'--clean[Delete current binary database files]' \
'-f[Force the operation (overrides safety checks)]' \
'--force[Force the operation (overrides safety checks)]' \
'-l[Enable legacy mode (historical compatibility only)]' \
'--legacy[Enable legacy mode (historical compatibility only)]' \
'-p[Prune old CSV archives after fetching]' \
'--prune[Prune old CSV archives after fetching]' \
'--no-log[Disable file logging, overriding \[logging\] in the config]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(build)
_arguments "${_arguments_options[@]}" : \
'(--no-log)--log-file=[Write the log to PATH, overriding \[logging\] in the config]:PATH:_default' \
'--config=[Read configuration from PATH instead of /etc/xtgeoip.conf]:PATH:_files' \
'--ca-file=[Verify the MaxMind server against the CA bundle in PATH]:PATH:_files' \
'-b[Back up current database before replacing it]' \
'--backup[Back up current database before replacing it]' \
'-c[Delete current binary database files]' \
'--clean[Delete current binary database files]' \
'-f[Force the operation (overrides safety checks)]' \
'--force[Force the operation (overrides safety checks)]' \
'-l[Enable legacy mode (historical compatibility only)]' \
'--legacy[Enable legacy mode (historical compatibility only)]' \
'-p[Prune old bin archives after backup (requires --backup)]' \
'--prune[Prune old bin archives after backup (requires --backup)]' \
'--no-log[Disable file logging, overriding \[logging\] in the config]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(fetch)
_arguments "${_arguments_options[@]}" : \
'(--no-log)--log-file=[Write the log to PATH, overriding \[logging\] in the config]:PATH:_default' \
'--config=[Read configuration from PATH instead of /etc/xtgeoip.conf]:PATH:_files' \
'--ca-file=[Verify the MaxMind server against the CA bundle in PATH]:PATH:_files' \
'-p[Prune old CSV archives after fetching]' \
'--prune[Prune old CSV archives after fetching]' \
'-l[]' \
'--legacy[]' \
'-b[]' \
'--backup[]' \
'-c[]' \
'--clean[]' \
'-f[]' \
'--force[]' \
'--no-log[Disable file logging, overriding \[logging\] in the config]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(conf)
_arguments "${_arguments_options[@]}" : \
'(--no-log)--log-file=[Write the log to PATH, overriding \[logging\] in the config]:PATH:_default' \
'--config=[Read configuration from PATH instead of /etc/xtgeoip.conf]:PATH:_files' \
'--ca-file=[Verify the MaxMind server against the CA bundle in PATH]:PATH:_files' \
'-d[Show default (example) configuration]' \
'--default[Show default (example) configuration]' \
'-s[Show system configuration]' \
'--show[Show system configuration]' \
'-e[Open system configuration in \$EDITOR]' \
'--edit[Open system configuration in \$EDITOR]' \
'-c[Encrypt and store MaxMind account_id/license_key (#103)]' \
'--set-credentials[Encrypt and store MaxMind account_id/license_key (#103)]' \
'--no-log[Disable file logging, overriding \[logging\] in the config]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
        esac
    ;;
esac
}

(( $+functions[_xtgeoip_commands] )) ||
_xtgeoip_commands() {
    local commands; commands=(
'run:Fetch then build the full pipeline' \
'build:Build binary database from local CSV archive' \
'fetch:Download GeoLite2 CSV archive from MaxMind' \
'conf:Manage system configuration' \
    )
    _describe -t commands 'xtgeoip commands' commands "$@"
}
(( $+functions[_xtgeoip__subcmd__build_commands] )) ||
_xtgeoip__subcmd__build_commands() {
    local commands; commands=()
    _describe -t commands 'xtgeoip build commands' commands "$@"
}
(( $+functions[_xtgeoip__subcmd__conf_commands] )) ||
_xtgeoip__subcmd__conf_commands() {
    local commands; commands=()
    _describe -t commands 'xtgeoip conf commands' commands "$@"
}
(( $+functions[_xtgeoip__subcmd__fetch_commands] )) ||
_xtgeoip__subcmd__fetch_commands() {
    local commands; commands=()
    _describe -t commands 'xtgeoip fetch commands' commands "$@"
}
(( $+functions[_xtgeoip__subcmd__run_commands] )) ||
_xtgeoip__subcmd__run_commands() {
    local commands; commands=()
    _describe -t commands 'xtgeoip run commands' commands "$@"
}

if [ "$funcstack[1]" = "_xtgeoip" ]; then
    _xtgeoip "$@"
else
    compdef _xtgeoip xtgeoip
fi
