[maxmind]
url = "https://download.maxmind.com/geoip/databases/GeoLite2-Country-CSV/download"
# Run `xtgeoip conf --set-credentials` to configure your MaxMind account_id
# and license_key. They are encrypted under a passphrase and written back
# here as [maxmind.credentials]; never put them in this file as plaintext.

[paths]
archive_dir = "/var/lib/xt_geoip"
archive_prune = 3
output_dir = "/usr/share/xt_geoip"

[logging]
log_file = "/var/log/xtgeoip.log"
verbose = false
